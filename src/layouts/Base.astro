---
/**
 * Base layout: HTML shell, head metadata, View Transitions wired,
 * persistent sidebar mounted. Dark-only — data-theme="dark" is static
 * on <html>; there is no theme toggle or bootstrap script.
 *
 * The Sidebar uses `transition:persist` so it stays alive across all
 * Astro View Transitions navigations (Phase 4 morphs, Phase 5 detail
 * pages).
 */
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";
import Sidebar from "../components/sidebar/Sidebar.astro";
import TemplateCredit from "../components/ui/TemplateCredit.astro";
import { getPortraitDesktop, getPortraitMobile } from "../lib/portraits";
// Critical font files, resolved to the same hashed URLs the fontsource CSS
// references (Vite dedupes the asset), so these preloads hit the cache the
// stylesheet then reads from. Only the two latin normal-weight files — the
// display serif and body sans are what visibly FOUT; Geist Mono (captions)
// can arrive with the stylesheet.
import loraLatinWoff2 from "@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url";
import geistLatinWoff2 from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Alt text for the OG image — describes the social share preview content. */
  ogImageAlt?: string;
  /** og:type — pass 'article' on writing detail pages. */
  ogType?: "website" | "article";
  /** Extra article:* meta, only meaningful with ogType="article". */
  article?: {
    publishedTime: Date;
    tags?: readonly string[];
  };
  /** Ask crawlers not to index (internal pages: /design, /thanks).
      robots.txt Disallow only stops crawling — a URL discovered elsewhere
      could still be indexed without this. */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogImage = site.defaultOgImage,
  ogImageAlt,
  ogType = "website",
  article,
  noindex = false,
} = Astro.props;

const fullTitle = title === site.title ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
// Avoid the "Name — Name" double-up on the home page when title === site.name.
const ogImageAltText =
  ogImageAlt ?? (title === site.title ? title : `${title} — ${site.name}`);

// Preload the AboutCell portrait on the home route only — it's the LCP
// candidate above the fold, so giving it `fetchpriority="high"` cuts ~600ms
// off the first paint vs. waiting for the bento grid to lay out first.
//
// Two variants (params centralized in src/lib/portraits.ts so these
// preloads and AboutCell's CSS backgrounds can't drift):
//   Desktop (≥1024px) — src/assets/me.webp resized to 560px (2× the fixed
//     280px bento box).
//   Mobile  (<1024px) — src/assets/in.png, a square crop for the
//     full-width 1:1 mobile cell, served as WebP at its native 800px.
//
// The two preload <link>s carry `media="..."` so only the variant the
// visitor will actually paint gets fetched — no double-download.
const isHome = Astro.url.pathname === "/";
const portraitDesktop = isHome ? await getPortraitDesktop() : null;
const portraitMobile = isHome ? await getPortraitMobile() : null;
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    {
      /* viewport-fit=cover unlocks env(safe-area-inset-*) on notched iPhones
        so full-bleed surfaces (gallery detail, drawer footer) can clear the
        Dynamic Island and home indicator. */
    }
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    {
      /* Dark-only site: color-scheme tells the UA to use its dark
        form-control / scrollbar palette; theme-color paints the mobile
        address-bar to match. The theme-color value must equal the active
        preset's --bg (src/styles/themes/_default.css) — update it if the
        preset @import in global.css changes. */
    }
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta property="og:locale" content={site.locale} />
    {
      ogType === "article" && article && (
        <>
          <meta
            property="article:published_time"
            content={article.publishedTime.toISOString()}
          />
          <meta property="article:author" content={site.author} />
          {(article.tags ?? []).map((t) => (
            <meta property="article:tag" content={t} />
          ))}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAltText} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      /* Font preloads — without these the woff2s are discovered only after
        the render-blocking CSS parses, guaranteeing a flash of fallback
        serif on every cold load. */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={loraLatinWoff2}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={geistLatinWoff2}
      crossorigin="anonymous"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — writing`}
      href="/writing/rss.xml"
    />
    {
      isHome && (
        <>
          {/* Desktop variant — square portrait, only fetched on ≥1024px. */}
          {portraitDesktop && (
            <link
              rel="preload"
              as="image"
              href={portraitDesktop.src}
              type="image/webp"
              media="(min-width: 1024px)"
              fetchpriority="high"
            />
          )}
          {/* Mobile variant — square crop, only fetched on <1024px. */}
          {portraitMobile && (
            <link
              rel="preload"
              as="image"
              href={portraitMobile.src}
              type="image/webp"
              media="(max-width: 1023.98px)"
              fetchpriority="high"
            />
          )}
        </>
      )
    }

    {
      /* Optional JSON-LD structured data — pages pass a `<JsonLd>` element
        into the `head` slot. Lives in <head> so search engines / AI agents
        parse it on first read; Google explicitly accepts both head and body
        but head is canonical. */
    }
    <slot name="head" />

    {
      /* Dark-only: data-theme="dark" is baked into the <html> tag above —
        no bootstrap script, no localStorage, no FOUC window. */
    }
    {
      /* Navigation-direction stamp — global.css keys the View Transition
        on it so back navigations read as a zoom-out instead of being
        visually identical to forward ones. Registered once per document;
        the listener survives ClientRouter navigations. */
    }
    <script is:inline>
      document.addEventListener("astro:before-preparation", function (e) {
        document.documentElement.dataset.navDirection =
          e.direction === "back" ? "back" : "forward";
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Sidebar />
    <slot />
    <TemplateCredit transition:persist="template-credit" />
  </body>
</html>
