---
/**
 * Writing cell — bottom of column 2.
 *
 * Pinned newsletter announcement when `site.newsletter` is set: the cell
 * body is non-interactive editorial copy, with one clickable subscribe
 * icon in the bottom-right corner that opens the newsletter URL in a new
 * tab (same destination the sidebar newsletter icon points at).
 *
 * Forker fallback: when `site.newsletter` is undefined, the cell renders
 * a plain entry point to `/writing` — no subscribe CTA, no italian/free
 * meta line. No transition:name on that link: /writing has no matching
 * destination element, so a name would be a source-less orphan (broken
 * morph). Edit the body copy directly here when the announcement changes.
 */
import Cell from '../ui/Cell.astro';
import { site } from '../../data/site';

interface Props {
  slot?: string;
}

const { slot } = Astro.props;

const newsletter = site.newsletter;
---

<Cell slot={slot}>
  {newsletter ? (
    <>
      <p class="text-caption muted">newsletter</p>
      <h2 class="text-h3 title">{newsletter.title}</h2>
      <p class="lede text-body muted">
        My brother Matteo and I launched a newsletter — free, in Italian. We
        write about academic choices, engineering, AI and ML, motivation, work
        experience, and the advice we wish we'd had along the way.
      </p>
      <p class="closer text-small">
        If it helps a few Italian students find their way a bit better, that's
        already a win.
      </p>
      <div class="meta-row">
        <p class="meta text-caption muted">free · in italian</p>
        <a class="notes-link text-caption" href="/writing" data-astro-prefetch>
          notes →
        </a>
        <a
          class="icon-btn subscribe"
          href={newsletter.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Subscribe to ${newsletter.title} — opens newsletter in a new tab`}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6h12v10H4zM4 6l6 5 6-5M19 9h3M19 12h3M19 15h3" />
          </svg>
        </a>
      </div>
    </>
  ) : (
    <a class="entry" href="/writing" data-astro-prefetch>
      <p class="text-caption muted">writing</p>
      <h2 class="text-h3 title">Notes</h2>
      <p class="lede text-body muted">
        Short essays, working notes, and longer pieces. Updated when there's
        something worth saying.
      </p>
      <p class="meta text-caption muted entry-cta">read more →</p>
    </a>
  )}
</Cell>

<style>
  .title {
    margin: 0;
    color: var(--text);
  }
  .lede {
    margin: 0;
    /* Clamp so the cell stays bounded at typical viewports. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-height: 800px) {
    .lede {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }
  .closer {
    margin: 0;
    color: var(--text);
  }

  .meta-row {
    /* margin-top: auto pushes the meta line + subscribe icon to the bottom
       of the cell so the announcement reads as anchored editorial copy. */
    margin: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .meta {
    margin: 0;
    /* Push notes-link + subscribe to the right edge as one cluster. */
    margin-right: auto;
  }

  .notes-link {
    /* Quiet text link into /writing — the icon stays the primary CTA. */
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .notes-link:hover,
  .notes-link:focus-visible {
    color: var(--accent);
  }
  .notes-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Icon-only link — skeleton (size, pill, tap-pad, focus ring) from the
     global .icon-btn base; accent hover matches the sidebar contacts row. */
  .subscribe:hover,
  .subscribe:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .subscribe:hover,
    .subscribe:focus-visible {
      transform: none;
    }
  }

  /* Forker fallback branch — when site.newsletter is undefined the cell
     becomes a plain block link into /writing. Cell chrome (border, padding,
     hover-lift) comes from the wrapping <Cell>; this just lays out the
     inner contents as a column and removes anchor styling. */
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .entry .lede {
    margin-bottom: auto;
  }
  .entry-cta {
    margin: 0;
    color: var(--text);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .entry:hover .entry-cta,
  .entry:focus-visible .entry-cta {
    color: var(--accent);
  }
  .entry:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
