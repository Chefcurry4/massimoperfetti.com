---
/**
 * Gallery cell — top of column 4.
 *
 * Renders the most-recent photo statically (so SSR / no-JS users still see
 * one) and cycles through the rest every 10s via the inline script below.
 * Each tick crossfades the photo, swaps the link `href` + ARIA label,
 * refreshes the meta strip, and rewrites the matching `view-transition-name`
 * so a click mid-cycle morphs to the photo currently on screen.
 *
 * Why inline `style="view-transition-name: …"` instead of Astro's
 * `transition:name` directive: the directive bakes the value into a scoped
 * stylesheet at build time. We need the value to track whatever photo is
 * visible right now, which means a runtime-mutable inline CSS property.
 * The destination /gallery/[slug] page keeps the static directive.
 *
 * Graceful degradation:
 *   – fewer than 2 photos: cycle is a no-op (single photo, no JS attached)
 *   – `prefers-reduced-motion: reduce`: cycle is a no-op
 *   – missing /public/gallery/* file: layered gradient fallback stays
 *     visible behind the broken <img> (same pattern as AboutCell + feed)
 */
import Cell from "../ui/Cell.astro";
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import { coverHues } from "../../lib/cover-color";

interface Props {
  entries: CollectionEntry<"gallery">[];
  slot?: string;
}

const { entries, slot } = Astro.props;

// Pre-compute one optimized URL per cycle entry. The first render uses the
// <Image> component (full srcset/AVIF support) — only swapped-in entries
// need plain URLs since the cycle script just writes img.src. Losing srcset
// on swapped images is acceptable: the LCP is the first image, and Astro's
// `getImage` already serves a sensibly-sized webp at the default width.
const optimizedSwaps = await Promise.all(
  entries.map((e) =>
    getImage({
      src: e.data.image,
      width: 900, // ~2× the cell's rendered width on mobile (95vw of ~430)
      format: "webp",
    }),
  ),
);

// Payload for the cycle script. SSR renders entries[0]; the script swaps in
// the rest at runtime. Hues precomputed here so the gradient fallback stays
// in lockstep with the active photo across cycles.
const cycleData = entries.map((e, i) => {
  const hues = coverHues(e.data.title);
  return {
    slug: e.id,
    image: optimizedSwaps[i].src,
    alt: e.data.alt ?? e.data.caption ?? e.data.title,
    title: e.data.title,
    location: e.data.location ?? "",
    hue: hues.hue,
    hueAlt: hues.hueAlt,
  };
});

const first = entries[0];
const { title, image, caption, location } = first.data;
const { hue, hueAlt } = coverHues(title);

const linkStyle = `view-transition-name: poster-gallery-${first.id}`;
const frameStyle = `--hue: ${hue}; --hue-alt: ${hueAlt}; view-transition-name: poster-gallery-${first.id}-image`;
const detailHref = `/gallery/${first.id}`;

const shouldCycle = entries.length > 1;
---

<a
  href={detailHref}
  class="card-link"
  style={linkStyle}
  data-gallery-cycle={shouldCycle ? "" : undefined}
  data-gallery-entries={shouldCycle ? JSON.stringify(cycleData) : undefined}
>
  <Cell slot={slot} class="gallery-cell">
    <div class="frame" style={frameStyle} data-gallery-frame>
      {
        /* First-render image: <Image> renders a single <img> with srcset,
          which the cycle script can update by swapping src + clearing
          srcset. <Picture> would need source-element manipulation — not
          worth the complexity for a 540px-wide bento cell. WebP is the
          default format; source files are already webp so this is mostly
          a width-ladder transformation. The page LCP is the AboutCell
          portrait, not this — `loading="lazy"` is fine. */
      }
      <Image
        src={image}
        alt={first.data.alt ?? caption ?? title}
        widths={[400, 600, 900]}
        sizes="(max-width: 1023.98px) 95vw, 540px"
        loading="lazy"
        decoding="async"
        data-gallery-img
      />
    </div>

    <div class="meta">
      <p class="text-caption muted">photograph</p>
      <h2 class="text-h3 title" data-gallery-title>{title}</h2>
      {
        /* Minimalism pass (2026-08): the caption line was dropped from the
          cell — title + location only; captions live on /gallery/[slug].
          Location always renders (never `hidden`) so the cycle can't change
          the meta height when a photo without one swaps in. */
      }
      <p class="exif-line text-caption muted" data-gallery-location>
        {location ?? ""}
      </p>
    </div>
  </Cell>
</a>

<style>
  .gallery-cell {
    padding: 0;
    overflow: hidden;
  }
  .frame {
    position: relative;
    flex: 1 1 60%;
    min-height: 0;
    overflow: hidden;
    background: var(--gradient-photo);
    border-bottom: 1px solid var(--border);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Opacity-only crossfade — compositor-safe and forgiving of mid-fade
       clicks (the morph snapshot still captures a sensible image).
       The cycle script reads this duration via getComputedStyle, so CSS
       and JS can never desync. Off-token 400ms: the photo crossfade wants
       to be slower than --duration-normal but calmer than --duration-slow's
       expo tail. */
    transition: opacity 400ms var(--ease-out-expo);
  }
  .meta {
    /* Lock the meta block's vertical footprint so the .frame above it
       can't shift when the cycle swaps content of varying length. 88 px
       is the sum of: eyebrow (~17) + title (~26) + exif-line (~17) +
       2 × gap (8) + 2 × padding (~16) ≈ 84 px, with a hair of headroom
       (the caption line was dropped in the minimalism pass — the photo
       absorbs the reclaimed height). flex: 0 0 fixes the basis. */
    flex: 0 0 88px;
    padding: clamp(var(--space-2), 1.2vw, var(--space-3));
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow: hidden;
  }
  .title {
    margin: 0;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .exif-line {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Reserve 1 line so empty location entries don't collapse the row. */
    min-height: 1lh;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame img {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Auto-cycle the gallery cell every 10s.
   *   – Pause while pointer is over the cell or keyboard focus is inside it
   *     (so a visitor reading the meta isn't yanked mid-thought).
   *   – Skip entirely under prefers-reduced-motion.
   *   – Pre-warm the next photo right after each swap so subsequent ticks
   *     don't surface a blank frame while the network fetches.
   *   – AbortController cleans up across `astro:page-load` so View
   *     Transitions back-navigation doesn't double-bind the timer.
   */
  type CycleEntry = {
    slug: string;
    image: string;
    alt: string;
    title: string;
    location: string;
    hue: number;
    hueAlt: number;
  };

  const INTERVAL_MS = 10000;

  function initGalleryCycle(signal: AbortSignal) {
    const link = document.querySelector<HTMLAnchorElement>(
      "a[data-gallery-cycle]",
    );
    if (!link) return;

    let entries: CycleEntry[];
    try {
      entries = JSON.parse(link.dataset.galleryEntries ?? "[]") as CycleEntry[];
    } catch {
      return;
    }
    if (entries.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const frame = link.querySelector<HTMLElement>("[data-gallery-frame]");
    const img = link.querySelector<HTMLImageElement>("[data-gallery-img]");
    const titleEl = link.querySelector<HTMLElement>("[data-gallery-title]");
    const locationEl = link.querySelector<HTMLElement>(
      "[data-gallery-location]",
    );
    if (!frame || !img) return;

    let index = 0;
    let paused = false;
    let pendingSwap = 0;

    // Fade duration comes from the CSS transition on the image, so the
    // stylesheet stays the single source of truth (previously a JS
    // constant silently duplicated the CSS value).
    const FADE_MS =
      (parseFloat(getComputedStyle(img).transitionDuration) || 0.4) * 1000;

    const preload = (i: number) => {
      const e = entries[i];
      if (!e) return;
      const pre = new Image();
      pre.decoding = "async";
      pre.src = e.image;
    };
    preload((index + 1) % entries.length);

    const swapTo = (next: number) => {
      const e = entries[next];
      img.style.opacity = "0";
      pendingSwap = window.setTimeout(() => {
        pendingSwap = 0;
        if (signal.aborted) return;
        // Clear srcset/sizes so the new single-resolution swap URL takes
        // effect — without this the browser would pick from the prior
        // srcset and ignore our `src` change. The first <Image>-rendered
        // photo carries full srcset; subsequent cycle entries are
        // single-resolution webp via getImage().
        img.removeAttribute("srcset");
        img.removeAttribute("sizes");
        img.src = e.image;
        img.alt = e.alt;
        link.href = `/gallery/${e.slug}`;
        link.setAttribute("aria-label", `Open ${e.title}`);
        link.style.viewTransitionName = `poster-gallery-${e.slug}`;
        frame.style.viewTransitionName = `poster-gallery-${e.slug}-image`;
        frame.style.setProperty("--hue", String(e.hue));
        frame.style.setProperty("--hue-alt", String(e.hueAlt));
        if (titleEl) titleEl.textContent = e.title;
        // Always set textContent (empty string when absent) and never toggle
        // `hidden` — the CSS `min-height` on .exif-line reserves the row's
        // vertical space, so swapping to a photo without a location doesn't
        // shrink the meta block and reflow the frame.
        if (locationEl) locationEl.textContent = e.location;
        img.style.opacity = "1";
        index = next;
        preload((index + 1) % entries.length);
      }, FADE_MS);
    };

    // A swap landing mid-navigation would rewrite href and the
    // view-transition names AFTER ClientRouter has snapshotted the source,
    // silently degrading the morph (or pointing it at the wrong slug).
    // Freeze the cycle the moment a navigation is in flight — and on
    // click, so the pending fade can't retarget the link under the finger.
    const freeze = () => {
      paused = true;
      if (pendingSwap) {
        window.clearTimeout(pendingSwap);
        pendingSwap = 0;
        // Un-fade whatever is currently shown; the click navigates to the
        // slug the href still points at.
        img.style.opacity = "1";
      }
    };
    link.addEventListener("click", freeze, { signal });
    document.addEventListener("astro:before-preparation", freeze, { signal });

    const tick = () => {
      // Skip while paused or backgrounded — a hidden tab kept cycling and
      // burning image decodes for nobody.
      if (paused || document.hidden) return;
      swapTo((index + 1) % entries.length);
    };

    const timer = window.setInterval(tick, INTERVAL_MS);

    link.addEventListener(
      "mouseenter",
      () => {
        paused = true;
      },
      { signal },
    );
    link.addEventListener(
      "mouseleave",
      () => {
        paused = false;
      },
      { signal },
    );
    link.addEventListener(
      "focusin",
      () => {
        paused = true;
      },
      { signal },
    );
    link.addEventListener(
      "focusout",
      () => {
        paused = false;
      },
      { signal },
    );
    // Touch pause — focus events fire briefly on a tap and don't reliably
    // hold; pointerdown/up give us actual finger-on-element semantics. A
    // visitor reading the meta on mobile shouldn't get yanked mid-thought.
    link.addEventListener(
      "pointerdown",
      () => {
        paused = true;
      },
      { signal },
    );
    link.addEventListener(
      "pointerup",
      () => {
        paused = false;
      },
      { signal },
    );
    link.addEventListener(
      "pointercancel",
      () => {
        paused = false;
      },
      { signal },
    );

    signal.addEventListener("abort", () => {
      window.clearInterval(timer);
      if (pendingSwap) window.clearTimeout(pendingSwap);
    });
  }

  let aborter: AbortController | null = null;
  function bindGalleryCycle() {
    aborter?.abort();
    aborter = new AbortController();
    initGalleryCycle(aborter.signal);
  }
  document.addEventListener("astro:page-load", bindGalleryCycle);
</script>
