---
/**
 * NextPrev — prev/next strip below RelatedProjects on /projects/[slug].
 *
 * Sorts the projects collection by `data.date` desc (same order as the
 * bento featured row), finds `current`, and hands the newer (left) / older
 * (right) siblings to the shared <AdjacentNav> for rendering. If both are
 * absent (single project), the section is omitted.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import AdjacentNav from "./AdjacentNav.astro";

interface Props {
  current: CollectionEntry<"projects">;
}

const { current } = Astro.props;

const all = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const idx = all.findIndex((e) => e.id === current.id);
// "newer" sits to the LEFT of current in a date-desc list (lower index).
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;
---

{
  (newer || older) && (
    <AdjacentNav
      label="Adjacent projects"
      newerLabel="← newer project"
      olderLabel="older project →"
      newer={
        newer && { href: `/projects/${newer.id}`, title: newer.data.title }
      }
      older={
        older && { href: `/projects/${older.id}`, title: older.data.title }
      }
    />
  )
}
