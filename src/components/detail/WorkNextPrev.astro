---
/**
 * WorkNextPrev — prev/next strip below RelatedWork on /work/[slug].
 * Mirrors NextPrev: sort by `period.start` desc (periodSortKey), find
 * current, hand the siblings to the shared <AdjacentNav>.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import { periodSortKey } from "../../lib/period";
import AdjacentNav from "./AdjacentNav.astro";

interface Props {
  current: CollectionEntry<"work">;
}

const { current } = Astro.props;

const all = (await getCollection("work", ({ data }) => !data.draft)).sort(
  (a, b) => periodSortKey(b.data.period) - periodSortKey(a.data.period),
);

const idx = all.findIndex((e) => e.id === current.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;
---

{
  (newer || older) && (
    <AdjacentNav
      label="Adjacent work"
      newerLabel="← newer role"
      olderLabel="older role →"
      newer={
        newer && {
          href: `/work/${newer.id}`,
          title: newer.data.title,
          subtitle: newer.data.org,
        }
      }
      older={
        older && {
          href: `/work/${older.id}`,
          title: older.data.title,
          subtitle: older.data.org,
        }
      }
    />
  )
}
