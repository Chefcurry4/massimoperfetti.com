---
/**
 * ReadingProgress — thin 2px bar fixed to the top of the viewport that fills
 * left-to-right as the page scrolls. Used on /projects/[slug] and
 * /writing/[slug] to give a sense of position during long reads.
 *
 * Implementation: a fixed-position div with `transform-origin: left;
 * transform: scaleX(N)`. N is the ratio `scrollY / (documentHeight - viewportHeight)`,
 * clamped to [0, 1].
 *
 * AbortController-managed listeners ensure clean teardown across
 * View Transitions navigations (re-bound on every astro:page-load).
 *
 * No CSS transition on the bar — the transform is written per animation
 * frame, so the value tracks scroll exactly (a discrete progress signal
 * stays useful under prefers-reduced-motion too).
 */
---

{
  /* transition:name keeps the bar out of the root View Transition snapshot
    so it doesn't smear through the page cross-fade; between two detail
    pages it simply stays put. */
}
<div
  class="reading-progress"
  data-reading-progress
  aria-hidden="true"
  transition:name="reading-progress"
>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: var(--z-progress);
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
    /* No transition — the value is written once per animation frame; a
       tween on top of that only makes the bar lag the scroll. */
    pointer-events: none;
    /* Long-lived, frequently-mutated transform — one of the two places
       will-change is justified on this site. */
    will-change: transform;
  }
</style>

<script>
  let abortController: AbortController | null = null;

  function bindReadingProgress() {
    const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
    if (!bar) return;

    abortController?.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    // scrollHeight is a forced-layout read — measure it once (and on
    // resize) instead of on every scroll tick, and coalesce transform
    // writes into rAF so scroll bursts cost one style write per frame.
    let max = 1;
    let rafId = 0;
    const measure = () => {
      max = Math.max(
        document.documentElement.scrollHeight - window.innerHeight,
        1,
      );
    };
    const update = () => {
      rafId = 0;
      const ratio = Math.max(0, Math.min(1, window.scrollY / max));
      bar.style.transform = `scaleX(${ratio.toFixed(4)})`;
    };
    const schedule = () => {
      if (!rafId) rafId = requestAnimationFrame(update);
    };

    measure();
    update();
    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener(
      "resize",
      () => {
        measure();
        schedule();
      },
      { passive: true, signal },
    );
  }

  bindReadingProgress();
  document.addEventListener("astro:page-load", bindReadingProgress);
</script>
