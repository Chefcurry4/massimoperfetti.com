---
/**
 * WorkLogo — dispatches a work entry to its inline-SVG logo component.
 *
 * Precedence (first match wins):
 *   1. Slug-mapped bespoke SVG component (e.g. DualEnergyLogo) — supports
 *      mono/color variants via currentColor + brand palette.
 *   2. entry.data.logo path → <img> rendered as-is in both variants. Use
 *      this for any logo you don't want to inline as an Astro component.
 *      Caveat: variant="mono" can't currentColor-tint external images;
 *      provide a monochrome asset if you want the icon-row treatment.
 *   3. Nothing. Caller (detail-page hero, RelatedWork) is responsible for
 *      showing its own monogram-over-gradient fallback via coverHueVars().
 *
 * Bespoke per-org components live in src/components/work/logos/* with the
 * same prop shape (variant, height, ariaLabel, class); register them via
 * the slug switch below.
 */
import type { CollectionEntry } from 'astro:content';
import DualEnergyLogo from './logos/DualEnergyLogo.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  variant?: 'mono' | 'color';
  height?: number;
  ariaLabel?: string;
  class?: string;
}

const {
  entry,
  variant = 'mono',
  height = 14,
  ariaLabel,
  class: className,
} = Astro.props;

const slug = entry.id;
const hasBespoke = slug === 'dualenergy';
const fallbackLogo = entry.data.logo;
const computedAlt = ariaLabel ?? entry.data.org;
---

{
  hasBespoke && (
    <DualEnergyLogo
      variant={variant}
      height={height}
      ariaLabel={ariaLabel}
      class={className}
    />
  )
}

{
  !hasBespoke && fallbackLogo && (
    <img
      src={fallbackLogo}
      alt={computedAlt}
      height={height}
      class={className}
      style="width:auto;display:inline-block;vertical-align:middle"
      loading="lazy"
      decoding="async"
    />
  )
}
