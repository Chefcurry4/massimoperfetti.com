---
/**
 * Bento cell primitive. Every wall cell wraps in this — same chrome,
 * same padding rhythm, same border radius.
 *
 * Pass `glass` for liquid-glass surfaces (used selectively per CLAUDE.md
 * §Liquid glass — about, see-all CTA). Pass `class` to extend with a
 * cell-slot identifier so mobile `order:` rules can grab it.
 *
 * Hover feedback is an opacity-only ::after overlay (see below) so every
 * cell gets the same affordance without layout or paint cost.
 * `.bento-cell.stub` is the "intentional empty slot" modifier, also styled
 * here so it picks up component scoping (avoids specificity ties with
 * `:global` overrides defined elsewhere).
 *
 * `min-width: 0` matters: without it, long children blow out CSS-grid tracks.
 */

interface Props {
  glass?: boolean;
  class?: string;
  /** Slot identifier for mobile order rules (e.g. "cell-about", "cell-project-1"). */
  slot?: string;
  /** Element override — defaults to <article>. */
  as?: "article" | "section" | "div";
}

const {
  glass = false,
  class: extra = "",
  slot,
  as: Tag = "article",
} = Astro.props;
const classes = ["bento-cell", glass ? "glass" : "", slot ?? "", extra]
  .filter(Boolean)
  .join(" ");
---

<Tag class={classes}>
  <slot />
</Tag>

<style>
  .bento-cell {
    /* Compact padding + gap — the wall is now a central strip with a
       hard height ceiling, so cells need to fit content inside a smaller
       envelope than they did when the wall filled the viewport. */
    padding: clamp(var(--space-3), 1.5vw, var(--space-4));
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    min-width: 0;
    overflow: hidden;
    /* Anchor for the ::after hover overlay. */
    position: relative;
  }

  /*
   * Hover affordance — history: every layout-affecting variant (translateY
   * lift, border+shadow swap) caused a visible cascade as the wall
   * scrolled past the cursor, because the retrigger cost layout/paint.
   * This version fades ONE compositor-cheap property (opacity) on a
   * pseudo-element: an accent-tinted inset ring plus a 4% wash. Opacity
   * retriggers during scroll are free, so the cascade can't come back.
   * pointer-events: none keeps the card-link fully clickable; the pseudo
   * is positioned, so it paints above the cell's static content without
   * needing a z-index.
   */
  .bento-cell::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Matches the cell's own radius (the stylelint radius allow-list
       doesn't accept `inherit`). */
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-hover);
    background: var(--hover-wash);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out-quad);
  }
  /* Hover-capable, precise pointers only — no sticky hover on touch. */
  @media (hover: hover) and (pointer: fine) {
    .bento-cell:hover::after,
    .bento-cell:focus-within::after {
      opacity: 1;
    }
  }

  /* `.glass` is defined globally in styles/global.css; redeclaring background
     here would override it, so we only swap the base background away. */
  .bento-cell.glass {
    background: var(--surface-glass);
  }

  /*
   * Stub modifier — empty slots styled as dashed-border placeholders.
   * Lives here (rather than in StubCell.astro) so the data-astro-cid
   * scoping wins specificity against any global override. Stubs are not
   * interactive, so no hover overlay.
   */
  .bento-cell.stub {
    background: transparent;
    border: 1px dashed var(--border-strong);
    align-items: center;
    justify-content: center;
    box-shadow: none;
  }
  .bento-cell.stub::after {
    display: none;
  }
</style>
