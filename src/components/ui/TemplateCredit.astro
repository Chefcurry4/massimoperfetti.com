---
/**
 * TemplateCredit — fixed bottom-right chip pointing at the open-source repo.
 *
 * Discoverability surface for visitors who read the newsletter article and
 * want to confirm "yes, this site is actually open source." Tiny mono-caption
 * text, low default opacity, brightens on hover/focus. Hidden on mobile
 * (drawer peek owns the bottom edge) and in print.
 *
 * Driven entirely by `site.templateRepoUrl` — set to an empty string in
 * src/data/site.ts to hide on forks. Token-only styling, no exemption needed
 * from the stylelint palette discipline.
 *
 * transition:name pairs with transition:persist (set in Base.astro): persist
 * keeps the node alive, the name excludes it from the root snapshot so it
 * doesn't double-image through every page cross-fade.
 */
import { site } from '../../data/site';

const repoUrl = site.templateRepoUrl;
---

{repoUrl && (
  <a
    class="template-credit"
    href={repoUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View this site's open-source template on GitHub"
    transition:name="template-credit"
  >
    <span class="text-mono-small">MIT-licensed template</span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
)}

<style>
  .template-credit {
    position: fixed;
    bottom: var(--wall-inset);
    right: var(--wall-inset);
    z-index: var(--z-progress);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-glass);
    backdrop-filter: blur(12px) saturate(130%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    color: var(--text-muted);
    text-decoration: none;
    opacity: 0.65;
    transition:
      opacity var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo);
  }
  .template-credit:hover,
  .template-credit:focus-visible {
    opacity: 1;
    color: var(--text);
    border-color: var(--border-strong);
  }
  .template-credit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .arrow {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
  }
  @media (max-width: 1023.98px) {
    /* Hidden on mobile — the drawer peek occupies the bottom edge and
       forkability discoverability matters most on desktop anyway. */
    .template-credit {
      display: none;
    }
  }
  @media print {
    .template-credit {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .template-credit {
      transition: none;
    }
  }
</style>
