---
/**
 * 404 — branded not-found page.
 *
 * Astro emits dist/404.html, which Netlify serves automatically for any
 * unknown route. Same centered-card chrome as /thanks so a dead link still
 * lands somewhere that feels like the site (sidebar, theme, a way back)
 * instead of the host's generic error screen.
 */
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist.">
  <main id="main" class="detail-page page">
    <article class="card">
      <p class="text-caption muted">404</p>
      <h1 class="text-h1 headline">Nothing here.</h1>
      <p class="lede text-body muted">
        This page doesn't exist — the link may be stale, or the address
        mistyped.
      </p>

      <div class="actions">
        <a href="/" class="text-caption back-link">← back to the wall</a>
        <a href="/projects" class="text-caption alt" data-astro-prefetch
          >→ browse projects instead</a
        >
      </div>
    </article>
  </main>
</Base>

<style>
  .page {
    /* Center the card vertically + horizontally — same arrival state
       as /thanks. */
    max-width: 560px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .muted {
    color: var(--text-muted);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-6) var(--space-5);
  }
  .headline {
    margin: 0;
    color: var(--text);
  }
  .lede {
    margin: 0;
    max-width: 44ch;
  }

  .actions {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  .alt {
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .alt:hover,
  .alt:focus-visible {
    color: var(--accent);
  }
  .alt:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
</style>
