---
/**
 * /about — standalone, deep-linkable page rendering the editorial about content.
 *
 * Page-only chrome: a dynamic grainy gradient backdrop (two soft radials
 * drifting across the viewport, plus an SVG fractal-noise overlay for film
 * grain). Both the drift and the noise honor `prefers-reduced-motion`.
 *
 * Body markup lives in `<AboutContent />`; this file owns only the page
 * chrome (sidebar-aware margin, padding, footer, backdrop).
 */
import Base from "../layouts/Base.astro";
import AboutContent from "../components/about/AboutContent.astro";
import JsonLd from "../components/ui/JsonLd.astro";
import { personSchema } from "../lib/structured-data";
import { site } from "../data/site";
import { getPortraitDesktop } from "../lib/portraits";

const portrait = await getPortraitDesktop();
---

<Base
  title="About"
  description={`Who ${site.author} is — researcher at MIT's van Rees Lab working on AI × CFD, founder, and engineer trained at MIT, TU Delft, EPFL, and PoliTo.`}
  ogImage="/og/about.png"
  ogImageAlt={`About ${site.author}`}
>
  <JsonLd slot="head" data={personSchema(portrait.src)} />
  <main id="main" class="page">
    {
      /* Drift backdrop host — two oversized gradient layers (::before/::after)
        that pan via transform. A separate element (rather than .page's own
        pseudos) because the two hotspots drift in opposite directions, which
        needs two independently-animated layers; .page::after stays the film
        grain. */
    }
    <div class="backdrop" aria-hidden="true"></div>
    <AboutContent />

    <footer class="meta">
      <span class="text-caption">{site.name}</span>
      <a href="/" class="back-link text-caption">← back</a>
    </footer>
  </main>
</Base>

<style>
  /* Sidebar-aware page chrome. AboutContent owns its own internal layout
     (head + facts + body); this rule positions the column relative to the
     viewport, caps it at an editorial reading width on huge monitors, and
     hosts the grainy backdrop. The page is left-anchored after the sidebar
     offset — magazine-profile aesthetic, not a centered novel page. */
  .page {
    position: relative;
    margin-left: calc(
      var(--wall-inset) + var(--sidebar-rail) + var(--sidebar-gap)
    );
    margin-right: var(--wall-inset);
    max-width: 960px;
    padding: clamp(var(--space-7), 10vh, var(--space-8))
      clamp(var(--space-4), 5vw, var(--space-6)) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    min-height: calc(100dvh - 2 * var(--wall-inset));
  }

  /*
   * Grainy gradient backdrop.
   *
   * .backdrop hosts two oversized (200%×200%) pseudo layers whose gradients
   * are baked in once and panned via `transform: translate3d` — compositor-
   * only, no repaint. The previous version animated background-position on
   * a full-viewport fixed layer, which repainted the whole viewport every
   * frame for the 32s loop (violating the animate-transform/opacity-only
   * rule). Same visual: base transforms are the old start positions and the
   * keyframes land on the old end positions.
   *
   * Colour budget is intentionally tiny: two small blue/purple ellipses
   * pinned to opposite corners on an otherwise solid black-ish field. The
   * low chroma keeps the page reading as black-with-a-whisper-of-colour.
   * .page::after is the SVG fractal-noise film grain (static).
   */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .backdrop::before,
  .backdrop::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 200%;
  }
  .backdrop::before {
    background: radial-gradient(
      ellipse 42% 38% at 15% 20%,
      oklch(58% 0.05 264 / 0.22),
      transparent 65%
    );
    transform: translate3d(0, 0, 0);
    animation: page-drift-a 32s ease-in-out infinite alternate;
  }
  .backdrop::after {
    background: radial-gradient(
      ellipse 38% 42% at 85% 80%,
      oklch(45% 0.07 295 / 0.2),
      transparent 65%
    );
    transform: translate3d(-50%, -50%, 0);
    animation: page-drift-b 32s ease-in-out infinite alternate;
  }
  .page::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* SVG fractal noise — film-grain texture so the gradient doesn't read
       as a flat colour blob. Overlay blend keeps the grain subtle on light
       areas, visible on dark. Opacity 0.30 so the noise sits softly on the
       deep black field. */
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='200' height='200'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    opacity: 0.3;
    mix-blend-mode: overlay;
  }

  @keyframes page-drift-a {
    to {
      transform: translate3d(-50%, -50%, 0);
    }
  }
  @keyframes page-drift-b {
    to {
      transform: translate3d(0, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .backdrop::before,
    .backdrop::after {
      animation: none;
    }
  }

  .meta {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    width: 100%;
  }

  /* Breakpoint matches the sidebar's rail→drawer switch (Sidebar.astro):
     below 1024px there is no rail, so no left gutter to reserve. A previous
     720px breakpoint left a dead ~100px gutter in the 721–1023px band. */
  @media (max-width: 1023.98px) {
    .page {
      margin-left: 0;
      margin-right: 0;
      /* Top: max(token, safe-top) so the page header clears the Dynamic
         Island. Sides: max(token, safe-{left,right}) for landscape on
         notched devices. Bottom: existing drawer clearance + safe-bottom. */
      padding: max(clamp(var(--space-6), 8vw, var(--space-7)), var(--safe-top))
        max(clamp(var(--space-4), 5vw, var(--space-5)), var(--safe-right))
        calc(var(--space-7) + var(--space-5) + var(--safe-bottom))
        max(clamp(var(--space-4), 5vw, var(--space-5)), var(--safe-left));
    }
  }
</style>
