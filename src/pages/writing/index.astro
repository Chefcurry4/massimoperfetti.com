---
/**
 * /writing — list of all non-draft notes & essays.
 *
 * Mirrors the /projects list-row pattern. Before this page existed the
 * only published essay was orphaned — reachable via RSS or a direct URL
 * only. Linked from the bento WritingCell (both branches).
 *
 * No view-transition-name on the rows — from a list view navigation is a
 * straight cross-fade (Astro's default), same rationale as /projects.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Writing" description="Notes and essays on ML, CFD, and engineering.">
  <main id="main" class="detail-page page">
    <a href="/" class="back-link text-caption">← back</a>

    <header class="head">
      <p class="text-caption muted">writing</p>
      <h1 class="text-h1 headline">Notes</h1>
      <p class="lede text-body muted">
        {entries.length} {entries.length === 1 ? 'note' : 'notes'}. Short
        essays and working notes, updated when there's something worth saying.
      </p>
    </header>

    {
      entries.length === 0 ? (
        <p class="empty text-body muted">Nothing published yet.</p>
      ) : (
        <ul class="list" aria-label="all notes">
          {entries.map((entry) => (
            <li>
              <a class="row" href={`/writing/${entry.id}`}>
                <div class="row-main">
                  <h2 class="text-h3 row-title">{entry.data.title}</h2>
                  <p class="text-small muted row-summary">{entry.data.summary}</p>
                </div>
                <div class="row-meta">
                  <span class="row-date text-caption muted">
                    {entry.data.date.toLocaleString('en-US', {
                      month: 'short',
                      year: 'numeric',
                    })}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>

<style>
  /* Page chrome (margin, padding, mobile reset, back link) provided by
     `.detail-page` and `.back-link` in global.css. */
  .page {
    max-width: 920px;
  }
  .muted {
    color: var(--text-muted);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .headline {
    margin: 0;
    color: var(--text);
  }
  .lede {
    margin: 0;
  }
  .empty {
    margin: var(--space-4) 0;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .list li:last-child .row {
    border-bottom: 1px solid var(--border);
  }
  .row:hover .row-title,
  .row:focus-visible .row-title {
    color: var(--accent);
  }
  .row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .row-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .row-title {
    margin: 0;
    color: var(--text);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .row-summary {
    margin: 0;
    /* clamp to 2 lines + ellipsis */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .row-meta {
      align-items: flex-start;
      flex-direction: row;
    }
  }
</style>
